# Only needed for MODE=testnet. Local mode needs nothing.
MODE=testnet

# Agent wallet (the payer). Use a NEW throwaway wallet that only holds testnet USDC.
# Generate one with:  npx tsx scripts/new-wallet.ts
AGENT_PRIVATE_KEY=0x...

# Merchant wallet that receives payments (any address you control; no funds needed).
MERCHANT_ADDRESS=0x...

# A second address used to demo the recipient allowlist (never actually paid).
UNLISTED_ADDRESS=0x...

# Optional
# FACILITATOR_URL=https://x402.org/facilitator
# POLICY_FILE=policy.example.json
# PORT=4021
